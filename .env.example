DB_ROOT_PASSWORD=change_this_root_password
DB_NAME=homeged
DB_USER=homeged
DB_PASSWORD=change_this_password

# Authentification — génère une vraie valeur secrète, ex: openssl rand -hex 32
SECRET_KEY=change_this_to_a_long_random_string
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Cookie de session : à passer à true dès que l'application est publiée derrière
# HTTPS. Laissé à false en local, sinon le navigateur refuserait le cookie sur
# une connexion en clair et la connexion deviendrait impossible.
COOKIE_SECURE=false

# Origines autorisées à appeler l'API depuis un navigateur (séparées par des
# virgules). Utile seulement pour le serveur de dev Vite : en production le
# frontend passe par nginx, donc par la même origine que l'API.
CORS_ORIGINS=http://localhost:8081,http://localhost:5173

# Protection contre la force brute sur /auth/login. Au-delà de
# LOGIN_MAX_TENTATIVES échecs dans la fenêtre, la source est écartée pendant la
# durée de verrouillage (valeurs en secondes). Mettre 0 désactive la limitation.
LOGIN_MAX_TENTATIVES=5
LOGIN_FENETRE_SECONDES=900
LOGIN_VERROUILLAGE_SECONDES=900


# Compte administrateur créé automatiquement au premier démarrage de l'API
ADMIN_EMAIL=admin@homeged.local
ADMIN_PASSWORD=change_this_admin_password
